37693>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37696>>>        WebSet pbRender of oNewButton to True
37697>>>        WebSet pbRender of oDetailButton to True
37698>>>
37698>>>        Case Begin
37698>>>            Case (NavigateData.eNavigateType = nfFromParent)
37700>>>                // If from parent, this is a constrained drill down
37700>>>                Case Break
37701>>>
37701>>>            Case (NavigateData.eNavigateType = nfFromChild)
37704>>>                // If from child, this is a probably a parent lookup from a Zoom
37704>>>                Case Break
37705>>>
37705>>>            Case (NavigateData.eNavigateType = nfFromMain)
37708>>>                // If from main, this is a probably a main-file lookup from a Zoom
37708>>>                WebSet pbRender of oDetailButton to False
37709>>>                Case Break
37710>>>
37710>>>            Case Else // must be nfUndefined
37710>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37710>>>
37710>>>        Case End
37710>>>
37710>>>    End_Procedure
37711>>>
