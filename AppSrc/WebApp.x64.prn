38576>>>    Procedure SetActionButtons
38579>>>        tWebNavigateData NavigateData
38579>>>        tWebNavigateData NavigateData
38579>>>        Boolean bHasRecord
38579>>>        Handle hoDD
38579>>>
38579>>>        Get Server to hoDD
38580>>>        Get GetNavigateData to NavigateData
38581>>>        Get HasRecord of hoDD to bHasRecord
38582>>>
38582>>>        // let's hide all buttons and then Show the ones we want
38582>>>        WebSet pbRender of oEditBtn to False
38583>>>        WebSet pbRender of oSaveBtn to False
38584>>>        WebSet pbRender of oCancelChangesBtn to False
38585>>>        WebSet pbRender of oDeleteBtn to False
38586>>>
38586>>>        If (NavigateData.bReadOnly) Begin
38588>>>            WebSet pbRender of oEditBtn to True
38589>>>        End
38589>>>>
38589>>>        Else Begin
38590>>>            WebSet pbRender of oSaveBtn to True
38591>>>            WebSet pbRender of oCancelChangesBtn to True
38592>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38593>>>        End
38593>>>>
38593>>>    End_Procedure
38594>>>
38594>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38597>>>        // Close after save
38597>>>        Send NavigateClose Self
38598>>>    End_Procedure
38599>>>
38599>>>    // this will close the view after a delete
38599>>>    Procedure OnViewDeleted Handle hoDDO
38602>>>        Send NavigateClose Self
38603>>>    End_Procedure
