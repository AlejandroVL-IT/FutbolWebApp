39333>>>                // If from main, this is a propbably a main file Select to Zoom.
39333>>>                Case Break
39334>>>
39334>>>            Case (NavigateData.eNavigateType = nfFromParent)
39337>>>                // If from parent, this is a constrained drill down.
39337>>>                Case Break
39338>>>
