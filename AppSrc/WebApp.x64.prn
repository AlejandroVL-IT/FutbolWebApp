38609>>>                // If from main, this is a propbably a main file Select to Zoom.
38609>>>                Case Break
38610>>>
38610>>>            Case (NavigateData.eNavigateType = nfFromParent)
38613>>>                // If from parent, this is a constrained drill down.
38613>>>                Case Break
38614>>>
38614>>>            Case (NavigateData.eNavigateType = nfFromChild)
38617>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38617>>>                Case Break
38618>>>
38618>>>            Case Else // must be nfUndefined
38618>>>
38618>>>        Case End
38618>>>
38618>>>        Send SetActionButtons
38619>>>
38619>>>    End_Procedure
38620>>>
38620>>>End_Object 
