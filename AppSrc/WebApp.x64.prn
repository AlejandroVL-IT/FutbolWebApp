39300>>>    Procedure SetActionButtons
39303>>>        tWebNavigateData NavigateData
39303>>>        tWebNavigateData NavigateData
39303>>>        Boolean bHasRecord
39303>>>        Handle hoDD
39303>>>
39303>>>        Get Server to hoDD
39304>>>        Get GetNavigateData to NavigateData
39305>>>        Get HasRecord of hoDD to bHasRecord
39306>>>
39306>>>        // let's hide all buttons and then Show the ones we want
39306>>>        WebSet pbRender of oEditBtn to False
39307>>>        WebSet pbRender of oSaveBtn to False
39308>>>        WebSet pbRender of oCancelChangesBtn to False
39309>>>        WebSet pbRender of oDeleteBtn to False
39310>>>
39310>>>        If (NavigateData.bReadOnly) Begin
39312>>>            WebSet pbRender of oEditBtn to True
39313>>>        End
39313>>>>
39313>>>        Else Begin
39314>>>            WebSet pbRender of oSaveBtn to True
39315>>>            WebSet pbRender of oCancelChangesBtn to True
39316>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39317>>>        End
39317>>>>
39317>>>    End_Procedure
