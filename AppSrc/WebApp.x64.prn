38820>>>    Procedure SetActionButtons
38823>>>        tWebNavigateData NavigateData
38823>>>        tWebNavigateData NavigateData
38823>>>        Boolean bHasRecord
38823>>>        Handle hoDD
38823>>>
38823>>>        Get Server to hoDD
38824>>>        Get GetNavigateData to NavigateData
38825>>>        Get HasRecord of hoDD to bHasRecord
38826>>>
38826>>>        // let's hide all buttons and then Show the ones we want
38826>>>        WebSet pbRender of oEditBtn to False
38827>>>        WebSet pbRender of oSaveBtn to False
38828>>>        WebSet pbRender of oCancelChangesBtn to False
38829>>>        WebSet pbRender of oDeleteBtn to False
38830>>>
38830>>>        If (NavigateData.bReadOnly) Begin
38832>>>            WebSet pbRender of oEditBtn to True
38833>>>        End
38833>>>>
38833>>>        Else Begin
38834>>>            WebSet pbRender of oSaveBtn to True
38835>>>            WebSet pbRender of oCancelChangesBtn to True
38836>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38837>>>        End
38837>>>>
38837>>>    End_Procedure
38838>>>
38838>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38841>>>        // Close after save
38841>>>        Send NavigateClose Self
38842>>>    End_Procedure
38843>>>
38843>>>    // this will close the view after a delete
38843>>>    Procedure OnViewDeleted Handle hoDDO
38846>>>        Send NavigateClose Self
38847>>>    End_Procedure
38848>>>
38848>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38851>>>        Case Begin
38851>>>            Case (NavigateData.eNavigateType = nfFromMain)
38853>>>                // If from main, this is a propbably a main file Select to Zoom.
38853>>>                Case Break
38854>>>
38854>>>            Case (NavigateData.eNavigateType = nfFromParent)
38857>>>                // If from parent, this is a constrained drill down.
38857>>>                Case Break
38858>>>
38858>>>            Case (NavigateData.eNavigateType = nfFromChild)
38861>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38861>>>                Case Break
38862>>>
38862>>>            Case Else // must be nfUndefined
38862>>>
38862>>>        Case End
38862>>>
38862>>>        Send SetActionButtons
38863>>>
38863>>>    End_Procedure
38864>>>
38864>>>End_Object 
